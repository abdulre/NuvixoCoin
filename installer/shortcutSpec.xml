<shortcuts>
	<skipIfNotSupported/>
	<defaultCurrentUser/>
	<programGroup defaultName="NuvixoCoin" location="startMenu"/>
	<shortcut
		name="NuvixoCoin Server"
		target="$INSTALL_PATH\NuvixoCoin.exe"
		commandLine=""
		workingDirectory="$INSTALL_PATH"
        description="Start NuvixoCoin server"
		iconFile="$INSTALL_PATH\html\www\favicon.ico"
        iconIndex="0"
        initialState="normal"
        programGroup="yes"
		desktop="yes"
        applications="no"
        startMenu="no"
		startup="no"
		runAsAdministrator="true">
	</shortcut>	
	<shortcut
		name="NuvixoCoin Wallet"
		target="http://localhost:5876/index.html"
		commandLine=""
		workingDirectory="$INSTALL_PATH"
        description="Launch NuvixoCoin wallet in browser"
		iconFile="$INSTALL_PATH\html\www\favicon.ico"
        iconIndex="0"
        initialState="normal"
        programGroup="yes"
		desktop="yes"
        applications="no"
        startMenu="no"
		startup="no">
	</shortcut>	
</shortcuts>